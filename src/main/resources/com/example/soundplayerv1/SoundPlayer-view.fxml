<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import com.jfoenix.controls.JFXSlider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.media.MediaView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.SoundPlayerController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 12px;">
            <Label styleClass="insta-label" text="insta : _klqc"/>
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                <Button fx:id="themeToggleButton"
                        onAction="#toggleTheme"
                        styleClass="theme-toggle-button"
                        text="🌙"/>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidePanel" spacing="10" style="-fx-min-width: 200px; -fx-padding: 16px;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Your Media"/>
            <ListView fx:id="soundListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30px;">
            <Label fx:id="fileNameLabel" text="No file loaded"/>

            <!-- Media Container with dynamic sizing -->
            <StackPane fx:id="mediaContainer" alignment="CENTER">
                <!-- Video View -->
                <MediaView fx:id="mediaView"
                           fitHeight="280"
                           fitWidth="380"
                           preserveRatio="true"
                           visible="false"
                           styleClass="media-view"/>

                <!-- Audio Disk Image -->
                <ImageView fx:id="diskImageView"
                           fitHeight="120"
                           fitWidth="120"
                           styleClass="disk-image"
                           visible="true"/>
            </StackPane>

            <HBox alignment="CENTER" spacing="12">
                <Label fx:id="currentTimeLabel" styleClass="time-label" text="0:00"/>
                <JFXSlider fx:id="progressSlider"
                           max="100"
                           min="0"
                           prefWidth="220"
                           styleClass="progress-slider"/>
                <Label fx:id="totalTimeLabel" styleClass="time-label" text="0:00"/>
            </HBox>

            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 0 5 0;">
                <!-- Volume -->
                <HBox alignment="CENTER" spacing="6">
                    <Label>
                        <graphic>
                            <FontIcon iconLiteral="fas-volume-up"
                                      iconSize="16"
                                      styleClass="volume-icon"/>
                        </graphic>
                    </Label>
                    <JFXSlider fx:id="volumeSlider"
                               max="100"
                               min="0"
                               prefWidth="80"
                               styleClass="volume-slider"
                               value="80"/>
                </HBox>

                <!-- Speed -->
                <HBox alignment="CENTER" spacing="6">
                    <Label styleClass="speed-label" text="Speed:"/>
                    <JFXComboBox fx:id="speedComboBox"
                                 prefWidth="90"
                                 styleClass="speed-combo"/>
                </HBox>
            </HBox>

            <!-- Enhanced Control Buttons with Previous/Next -->
            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="previousButton"
                        onAction="#onPrevious"
                        styleClass="nav-button"
                        text="⏮"/>
                <Button fx:id="playPauseButton"
                        onAction="#onPlayPause"
                        styleClass="play-pause-button"
                        text="▶"/>
                <Button fx:id="nextButton"
                        onAction="#onNext"
                        styleClass="nav-button"
                        text="⏭"/>
                <Button fx:id="resetButton"
                        onAction="#onReset"
                        styleClass="reset-button"
                        text="Reset"/>
                <Button onAction="#onOpenFile"
                        styleClass="open-file-button"
                        text="Open Media"/>
                <Button fx:id="sidePanelToggleButton"
                        styleClass="side-panel-toggle-button"
                        text="Show Media"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>